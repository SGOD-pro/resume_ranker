# ── Resume Ranker V2 — Environment Configuration Template ───────────────────
# Copy this file to .env and adjust variables as needed.
# NEVER commit .env to source control.

# ── Storage & DB (DynamoDB / S3) ─────────────────────────────────────────────
# LocalStack or real AWS endpoints
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=ap-south-1

S3_BUCKET_NAME=resume-ranker-dev-storage
DYNAMODB_TABLE_NAME=ResumePlatform

# ── Authentication & Security ────────────────────────────────────────────────
# Secret key used for signing session tokens (generate a random 32+ char hex in production)
SESSION_SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-32-chars
SESSION_COOKIE_NAME=sortlist_session
SESSION_MAX_AGE_SECONDS=86400

# ── App & Network ────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_UPLOAD_PER_MIN=15
RATE_LIMIT_ATS_PER_MIN=10

# ── Optional Adapters ────────────────────────────────────────────────────────
ENABLE_ODL=false
ENABLE_NOVA=false
