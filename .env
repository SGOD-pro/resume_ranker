# ── Resume Ranker V2 — Local Development ──────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/resume_ranker

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── AWS Core ──────────────────────────────────────────────────────────────────
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=ap-south-1

# ── S3 ────────────────────────────────────────────────────────────────────────
S3_BUCKET_NAME=resume-ranker-dev-storage

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=DEBUG
FRONTEND_URL=http://localhost:5173
